{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "ask",
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch --show-current": "allow",
      "git rev-parse*": "allow",
      "git commit*": "deny",
      "git push*": "deny",
      "git merge*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git rebase*": "deny",
      "git checkout*": "deny",
      "git switch*": "deny"
    }
  },
  "agent": {
    "build": {
      "description": "默认实施角色：只在隔离 worktree 内按任务合同改动，禁止提交、推送、合并和部署。",
      "mode": "primary",
      "permission": {
        "edit": "ask",
        "external_directory": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git rev-parse*": "allow",
          "git commit*": "deny",
          "git push*": "deny",
          "git merge*": "deny",
          "git reset*": "deny",
          "git clean*": "deny",
          "git rebase*": "deny",
          "git checkout*": "deny",
          "git switch*": "deny"
        }
      }
    },
    "design-review": {
      "description": "只读设计与架构审查：检查任务边界、模块依赖、验收命令和风险，不修改代码。",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "external_directory": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "implement": {
      "description": "在明确任务合同和隔离 worktree 中实施一个模块；禁止提交、推送、合并和部署。",
      "mode": "primary",
      "permission": {
        "external_directory": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "test": {
      "description": "独立运行与变更相称的测试和证据检查；默认不修改代码。",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "external_directory": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    }
  }
}
