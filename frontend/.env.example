# 服务端专用变量：Next.js 服务端（Route Handler / Server Component）调用后端
# FastAPI 服务时使用的基础 URL。刻意不加 `NEXT_PUBLIC_` 前缀，避免被打包到浏览器端。
# 未设置时 backendClient 默认使用同样的值：http://127.0.0.1:8000
BACKEND_BASE_URL=http://127.0.0.1:8000

# Local start-local.ps1 runs over HTTP and sets this to false automatically.
# Leave unset (or set true) for HTTPS deployments so session cookies remain Secure.
CHAOTANG_COOKIE_SECURE=true
