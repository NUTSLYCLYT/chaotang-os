# nginx-app.conf.template — 公网反向代理（朝堂专用 nginx 实例）
# 安装步骤：
#   cp deploy/nginx-app.conf.template ~/.local/nginx-app/nginx.conf
#   # 确认 SSL 证书存在：
#   ls ~/.local/nginx-app/ssl/origin.pem ~/.local/nginx-app/ssl/origin.key
#   systemctl --user restart nginx-app.service
#
# 服务器名：app.mingshuoxny.com
# 端口：:8443 SSL → cloudflared 隧道 → 公网 :443
# upstream：courtos-web :3050（Next.js prod）/ jiqun :8081（后端，由 Next.js 代理）

worker_processes 1;
pid /home/ubuntu/.local/nginx-app/logs/nginx.pid;
error_log /home/ubuntu/.local/nginx-app/logs/error.log;

events {
    worker_connections 1024;
}

http {
    include /home/linuxbrew/.linuxbrew/etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /home/ubuntu/.local/nginx-app/logs/access.log;
    sendfile on;
    keepalive_timeout 65;

    server {
        listen 8443 ssl;
        server_name app.mingshuoxny.com localhost;

        ssl_certificate /home/ubuntu/.local/nginx-app/ssl/origin.pem;
        ssl_certificate_key /home/ubuntu/.local/nginx-app/ssl/origin.key;
        ssl_protocols TLSv1.2 TLSv1.3;

        root /home/ubuntu/.local/nginx-app/html;
        index index.html;

        # CourtOS 朝堂系统 (Next.js basePath=/chaotang)
        # 浏览器 fetch 是相对原点，basePath 不会自动加前缀，需要 nginx 层在 root 补兜底

        # 真实后端（若有 NestJS :4000）
        location ^~ /api/v1/ {
            proxy_pass http://127.0.0.1:4000;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 120s;
        }

        # WebSocket (NestJS Gateway)
        location ^~ /socket.io/ {
            proxy_pass http://127.0.0.1:4000;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_read_timeout 3600s;
            proxy_buffering off;
        }

        # Next.js BFF /api/* → /chaotang/api/*
        location ^~ /api/ {
            proxy_pass http://127.0.0.1:3050/chaotang/api/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 120s;
        }

        # 静态资源（绝对路径的 webp/png/svg 等不会自动带 basePath）
        location ~* \.(webp|png|jpe?g|svg|gif|ico|mp4|woff2?|ttf|eot|otf|avif)$ {
            proxy_pass http://127.0.0.1:3050/chaotang$request_uri;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 60s;
        }

        # jiqun API（由 Next.js 代理后转发，不直连 :8081）
        location ^~ /chaotang/jiqun/api {
            proxy_pass http://127.0.0.1:3050;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 300s;
            proxy_buffering off;
        }

        # jiqun 页面
        location ^~ /chaotang/jiqun {
            proxy_pass http://127.0.0.1:3050;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_read_timeout 300s;
            proxy_buffering off;
        }

        # Next.js 主体（所有 /chaotang/* 路由）
        location ^~ /chaotang {
            proxy_pass http://127.0.0.1:3050;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_read_timeout 300s;
            proxy_buffering off;
        }

        # 根路径重定向到 basePath
        # absolute_redirect off：内部 :8443 不能写到 Location（cloudflared 隧道在 :443）
        location = / {
            absolute_redirect off;
            return 308 /chaotang/;
        }

        location / {
            try_files $uri $uri/ =404;
        }
    }

    # www 子域（指向其他服务，如 kinddom-website :3060）
    server {
        listen 8443 ssl;
        server_name www.mingshuoxny.com;

        ssl_certificate /home/ubuntu/.local/nginx-app/ssl/origin.pem;
        ssl_certificate_key /home/ubuntu/.local/nginx-app/ssl/origin.key;
        ssl_protocols TLSv1.2 TLSv1.3;

        location / {
            proxy_pass http://127.0.0.1:3060;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_read_timeout 120s;
        }
    }
}
