# chaotang-os frontend 生产环境变量
# 复制为 .env.local 并填入真实值，绝不提交 .env.local 到 git

# ── 前端模式（上线前必须是 real）──────────────────────────────
NEXT_PUBLIC_API_MODE=real
NEXT_PUBLIC_BASE_PATH=/chaotang

# ── jiqun 后端（产线执行引擎 :8081）────────────────────────────
JIQUN_API_URL=http://127.0.0.1:8081
JIQUN_BASE_URL=http://127.0.0.1:8081
NEXT_PUBLIC_WS_URL=http://127.0.0.1:8081

# ── LLM 网关（LiteLLM proxy :4444）────────────────────────────
OPENAI_BASE_URL=http://127.0.0.1:4444/v1
OPENAI_API_KEY=sk-litellm-master-key-here   # 与 ~/.openclaw/litellm_config.yaml general_settings.master_key 一致

# ── 法务 agent（:18003）─────────────────────────────────────────
LEGAL_AGENT_BASE_URL=http://127.0.0.1:18003

# ── 数据库（Turso 云；缺失时降 file:本地 SQLite）──────────────
TURSO_DB_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=eyJ...your-turso-auth-token

# ── 鉴权（必须与 jiqun JWT_SECRET 完全一致）────────────────────
JWT_SECRET=your-jwt-secret-minimum-32-chars

# ── 后端验签门（生产必须 true；false = decode-only 可被 alg:none 绕过）
FENGQUN_AUTH=true
FENGQUN_JWT_KEY_ID=jwt-prod-rotation-id

# ── prod:doctor JWT 运行身份门 ─────────────────────────────────
PROD_DOCTOR_BACKEND_URL=http://127.0.0.1:8081
CHAOTANG_EXPECTED_JWT_KEY_ID=jwt-prod-rotation-id
# CHAOTANG_RUNTIME_PROBE_TOKEN 由外部发布权限方临时注入，禁止写入本文件或 Git

# ── jiqun 验签路径（身份探针，配合 backendVerifyOrReject）───────
JIQUN_VERIFY_PATH=/api/chaotang/study/briefing

# ── 遗物后端（若无则 503 诚实返回，不要设假地址）───────────────
# COURTOS_API_URL=http://127.0.0.1:4000/api
# INTERNAL_API_URL=http://127.0.0.1:4000/api

# ── 功能开关（默认关）────────────────────────────────────────────
# COURT_REAL_MINISTRY_AGENTS=1       # 1=接真 LLM agent，0=纯规则
# DEPARTMENT_LEARNING_FEED_DECISIONS=0   # 1=开，0=只观测

# ── 监控 webhook（可选，DOWN 时发 Telegram）──────────────────────
# CHAOTANG_ALERT_URL=https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<CHAT_ID>
