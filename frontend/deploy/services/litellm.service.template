# litellm.service.template
# 安装：cp deploy/services/litellm.service.template ~/.config/systemd/user/litellm.service
#        systemctl --user daemon-reload && systemctl --user enable --now litellm
# 依赖：~/.openclaw/litellm_config.yaml 必须先配置（见 deploy/litellm-config.template.yaml）

[Unit]
Description=LiteLLM Proxy for OpenClaw (:4444)
After=network-online.target
After=redislite.service
Wants=redislite.service

[Service]
WorkingDirectory=/home/ubuntu/.openclaw
ExecStartPre=/home/ubuntu/.openclaw/script/litellm-preflight.sh
ExecStart=/home/ubuntu/.openclaw/start-litellm.sh
ExecStartPost=/home/ubuntu/.openclaw/script/litellm-healthcheck.sh
Restart=on-failure
RestartSec=15
Environment=HOME=/home/ubuntu
StandardOutput=append:/home/ubuntu/.openclaw/log/litellm.log
StandardError=append:/home/ubuntu/.openclaw/log/litellm.log

[Install]
WantedBy=default.target
