# legal-agent-manor.service.template
# 安装：cp deploy/services/legal-agent-manor.service.template ~/.config/systemd/user/legal-agent-manor.service
#        systemctl --user daemon-reload && systemctl --user enable --now legal-agent-manor
# 代码：git clone git@github.com:NUTSLYCLYT/legal-agent.git /home/ubuntu/legal-agent

[Unit]
Description=Legal Agent Manor API for CourtOS (:18003)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/legal-agent
Environment=PATH=/home/ubuntu/legal-agent/.venv/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/home/ubuntu/legal-agent/.env
ExecStart=/home/ubuntu/legal-agent/.venv/bin/python -m uvicorn legal_agent.api:app --host 127.0.0.1 --port 18003 --app-dir /home/ubuntu/legal-agent/src
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/ubuntu/.openclaw/log/legal-agent-manor.log
StandardError=append:/home/ubuntu/.openclaw/log/legal-agent-manor.log

[Install]
WantedBy=default.target
