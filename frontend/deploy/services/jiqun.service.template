# jiqun.service.template
# 安装：cp deploy/services/jiqun.service.template ~/.config/systemd/user/jiqun.service
#        systemctl --user daemon-reload && systemctl --user enable --now jiqun
# 代码：/home/ubuntu/Projects/chaotang-os/backend
# 仓库：git@gitee.com:msxn/chaotang-os.git

[Unit]
Description=Jiqun AI Backend (:8081)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/Projects/chaotang-os/backend
Environment=PATH=/home/ubuntu/Projects/chaotang-os/backend/.venv/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/home/ubuntu/Projects/chaotang-os/backend/.env
Environment=FENGQUN_SCHEMA_MODE=strict
ExecStart=/usr/bin/env FENGQUN_SCHEMA_MODE=strict /home/ubuntu/Projects/chaotang-os/backend/.venv/bin/python -m gunicorn -c gunicorn.conf.py web.main:app
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/ubuntu/.openclaw/log/jiqun.log
StandardError=append:/home/ubuntu/.openclaw/log/jiqun.log

[Install]
WantedBy=default.target
