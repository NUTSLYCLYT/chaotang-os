# jiqun.service.template
# 安装：cp deploy/services/jiqun.service.template ~/.config/systemd/user/jiqun.service
#        systemctl --user daemon-reload && systemctl --user enable --now jiqun
# 代码：/home/ubuntu/fe/fengQun/jiqun_ai_fresh
# 仓库：git@gitee.com:msxn/jiqun_ai.git

[Unit]
Description=Jiqun AI Backend (:8081)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/fe/fengQun/jiqun_ai_fresh
Environment=PATH=/home/ubuntu/fe/fengQun/jiqun_ai_fresh/.venv/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/home/ubuntu/fe/fengQun/jiqun_ai_fresh/.env
ExecStart=/home/ubuntu/fe/fengQun/jiqun_ai_fresh/.venv/bin/uvicorn web.main:app --host 127.0.0.1 --port 8081 --workers 2
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/ubuntu/.openclaw/log/jiqun.log
StandardError=append:/home/ubuntu/.openclaw/log/jiqun.log

[Install]
WantedBy=default.target
