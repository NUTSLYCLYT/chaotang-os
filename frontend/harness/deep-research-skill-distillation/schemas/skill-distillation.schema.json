{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chaotang.deep_research.skill_distillation",
  "title": "Chaotang Skill Distillation",
  "type": "object",
  "required": [
    "skill_name",
    "source_pack",
    "learning_pack",
    "candidate_skill_path",
    "golden_cases_path",
    "output_contract",
    "hard_gates"
  ],
  "properties": {
    "skill_name": { "type": "string", "minLength": 3 },
    "source_pack": { "type": "string", "minLength": 3 },
    "learning_pack": { "type": "string", "minLength": 3 },
    "candidate_skill_path": { "type": "string", "minLength": 3 },
    "golden_cases_path": { "type": "string", "minLength": 3 },
    "output_contract": { "type": "array", "minItems": 6, "items": { "type": "string" } },
    "hard_gates": { "type": "array", "minItems": 6, "items": { "type": "string" } }
  }
}
