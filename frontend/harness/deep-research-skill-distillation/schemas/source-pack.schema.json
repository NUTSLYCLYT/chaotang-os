{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chaotang.deep_research.source_pack",
  "title": "Chaotang Deep Research Source Pack",
  "type": "object",
  "required": ["topic", "created_at", "owner", "risk_level", "sources", "claims"],
  "properties": {
    "topic": { "type": "string", "minLength": 3 },
    "created_at": { "type": "string", "minLength": 10 },
    "owner": { "type": "string", "minLength": 2 },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high"] },
    "sources": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "url",
          "title",
          "publisher",
          "accessed_at",
          "source_type",
          "reliability",
          "license_or_terms_note"
        ],
        "properties": {
          "source_id": { "type": "string", "minLength": 2 },
          "url": { "type": "string", "minLength": 8 },
          "title": { "type": "string", "minLength": 3 },
          "publisher": { "type": "string", "minLength": 2 },
          "published_at": { "type": ["string", "null"] },
          "accessed_at": { "type": "string", "minLength": 10 },
          "source_type": {
            "type": "string",
            "enum": ["primary", "issuer", "regulatory", "news", "media_repost", "social", "mirror", "analysis"]
          },
          "reliability": { "type": "string", "enum": ["high", "medium", "low"] },
          "license_or_terms_note": { "type": "string", "minLength": 3 },
          "red_flags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "claim",
          "source_ids",
          "claim_type",
          "evidence_level",
          "confidence",
          "uncertainty",
          "card_color"
        ],
        "properties": {
          "claim_id": { "type": "string", "minLength": 2 },
          "claim": { "type": "string", "minLength": 8 },
          "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "claim_type": { "type": "string", "minLength": 3 },
          "evidence_level": {
            "type": "string",
            "enum": ["primary_verified", "issuer_biased", "media_social_unverified", "conflicting", "prohibited"]
          },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "uncertainty": { "type": "string", "minLength": 4 },
          "card_color": { "type": "string", "enum": ["green", "yellow", "red", "black"] },
          "contradictions": { "type": "array", "items": { "type": "string" } },
          "requires_manual_review": { "type": "boolean" }
        }
      }
    }
  }
}
