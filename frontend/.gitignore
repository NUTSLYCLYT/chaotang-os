# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: 复用仓库根 .gitignore 的 `.env*` / `!.env.example` 规则，此处不重复
# 声明，避免子目录规则覆盖根目录对 .env.example 的例外。

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
