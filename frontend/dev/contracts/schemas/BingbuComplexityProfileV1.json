{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BingbuComplexityProfileV1",
  "type": "object",
  "required": [
    "mode",
    "headcountBand",
    "defaultView",
    "exposeSubOfficeStructure",
    "enabledSubOffices",
    "nonNegotiableFloor",
    "sourceLabel"
  ],
  "properties": {
    "mode": {
      "enum": [
        "founder_sales_assistant",
        "small_team_sales_manager",
        "growth_sales_engine",
        "cro_revops",
        "enterprise_revenue_governance"
      ]
    },
    "headcountBand": { "enum": ["1-10", "10-50", "50-200", "200-1000", "1000+"] },
    "defaultView": { "enum": ["brief", "management_detail", "professional_detail"] },
    "exposeSubOfficeStructure": {
      "type": "boolean",
      "description": "Small companies must not see the eight-sub-office structure by default."
    },
    "enabledSubOffices": {
      "type": "array",
      "items": {
        "enum": [
          "cro_chief",
          "gtm_strategy",
          "opportunity_pipeline",
          "key_account_attack",
          "pricing_deal_desk",
          "channel_partner",
          "sales_revops",
          "customer_success_growth"
        ]
      }
    },
    "lightweightSubOffices": { "type": "array", "items": { "type": "string" } },
    "highRiskExtraOffices": { "type": "array", "items": { "type": "string" } },
    "reservedCapabilities": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Enterprise-only placeholders, not implemented in v0."
    },
    "nonNegotiableFloor": {
      "type": "array",
      "items": {
        "enum": [
          "high_risk_requires_human_confirmation",
          "hubu_review_for_quote_discount_roi",
          "xingbu_review_for_contract_commitment_exclusivity",
          "rites_review_for_external_message",
          "jinyiwei_review_for_customer_claim_or_competitor_claim",
          "source_label_required",
          "evidence_or_gap_required",
          "no_auto_send_customer_message"
        ]
      }
    },
    "sourceLabel": { "enum": ["LIVE", "LIVE_SWARM", "MIXED", "FALLBACK", "DEMO"] }
  },
  "additionalProperties": true
}
