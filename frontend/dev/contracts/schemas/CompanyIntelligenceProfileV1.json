{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CompanyIntelligenceProfileV1",
  "type": "object",
  "required": [
    "companyId",
    "headcount",
    "companySizeBand",
    "intelligenceMaturity",
    "defaultJinyiweiMode",
    "sourceLabel"
  ],
  "properties": {
    "companyId": { "type": "string" },
    "headcount": { "type": "integer", "minimum": 1 },
    "companySizeBand": { "enum": ["1-10", "10-50", "50-200", "200-1000", "1000+"] },
    "intelligenceMaturity": { "enum": ["ad_hoc", "basic", "managed", "professional", "governed"] },
    "defaultJinyiweiMode": {
      "enum": [
        "founder_info_assistant",
        "small_team_research",
        "growth_intelligence",
        "chief_intelligence_office",
        "enterprise_intelligence_governance"
      ]
    },
    "preferredView": { "enum": ["brief", "evidence_detail", "professional_detail"] },
    "knownAuthorizedSources": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Only sources the company has authorized CourtOS to use."
    },
    "watchlistEnabled": { "type": "boolean" },
    "sourceLabel": { "enum": ["LIVE", "LIVE_SWARM", "MIXED", "FALLBACK", "DEMO"] }
  },
  "additionalProperties": true
}
