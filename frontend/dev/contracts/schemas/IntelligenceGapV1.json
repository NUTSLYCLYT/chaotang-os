{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IntelligenceGapV1",
  "type": "object",
  "required": ["id", "question", "intelligenceType", "neededFor", "priority", "blocking", "sourceLabel"],
  "properties": {
    "id": { "type": "string" },
    "question": { "type": "string" },
    "intelligenceType": { "enum": ["CUSTOMER_INTEL", "COMPETITOR_INTEL", "MARKET_INTEL", "POLICY_INTEL", "PROJECT_INTEL", "INTERNAL_INTEL", "RISK_INTEL", "PEOPLE_INTEL"] },
    "neededFor": { "enum": ["decision", "risk", "budget", "legal", "execution", "messaging", "archive"] },
    "owner": { "enum": ["jinyiwei", "finance", "war", "personnel", "justice", "ritual", "works", "user"] },
    "priority": { "enum": ["P0", "P1", "P2"] },
    "blocking": { "type": "boolean" },
    "recommendedAction": { "type": "string" },
    "sourceLabel": { "enum": ["LIVE", "LIVE_SWARM", "MIXED", "FALLBACK", "DEMO"] }
  },
  "additionalProperties": true
}
