{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://courtos.local/schemas/EvoMapEventV1.json",
  "title": "EvoMapEventV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "task_id",
    "loop_trace_id",
    "loop_id",
    "user_action",
    "learned_preference",
    "recommended_change",
    "source_label",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "EvoMapEventV1" },
    "event_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "loop_trace_id": { "type": "string", "minLength": 1 },
    "loop_id": { "const": "court_unified_decision_loop_v1" },
    "user_action": { "enum": ["adopt", "reject", "request_evidence", "request_recheck", "follow_up"] },
    "learned_preference": { "type": "string" },
    "failure_mode": { "type": "string" },
    "recommended_change": { "type": "string" },
    "archive_id": { "type": "string" },
    "quality_gate_status": { "enum": ["passed", "blocked", "unknown"] },
    "evidence_gap_count": { "type": "number" },
    "department_ids": { "type": "array", "items": { "type": "string" } },
    "swarm_runtime_status": {
      "enum": ["skipped_not_required", "skipped_no_live_adapter", "completed", "blocked", "unknown"]
    },
    "reusable_lessons": { "type": "array", "items": { "type": "string" } },
    "auto_apply": { "const": false },
    "source_label": { "$ref": "#/$defs/source_label" },
    "created_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "source_label": { "enum": ["LIVE", "LIVE_SWARM", "MIXED", "FALLBACK", "DEMO"] }
  }
}
