{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImperialMemorialV1",
  "description": "User-facing decision report synthesized by Junjichu. Shangshufang should display only the precise brief, while Junjichu/report pages can drill into department, swarm, evidence, and download sections.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "task_id",
    "review_id",
    "title",
    "one_sentence_verdict",
    "verdict",
    "overall_signal",
    "emperor_question",
    "next_best_action",
    "ministry_signals",
    "department_summaries",
    "evidence_chain",
    "missing_evidence",
    "risk_register",
    "conflicts",
    "quality_gate",
    "decision_actions",
    "downloadable_artifacts",
    "archive_info",
    "needs_human_confirmation",
    "confidence",
    "source_label"
  ],
  "properties": {
    "schema_version": { "const": "ImperialMemorialV1" },
    "id": { "type": "string" },
    "task_id": { "type": "string" },
    "review_id": { "type": "string" },
    "title": { "type": "string" },
    "one_sentence_verdict": { "type": "string" },
    "verdict": { "enum": ["APPROVE", "NEED_EVIDENCE", "RECHECK", "REJECT"] },
    "overall_signal": { "enum": ["GREEN", "YELLOW", "RED", "GRAY"] },
    "emperor_question": { "type": "string" },
    "next_best_action": {
      "type": "object",
      "required": ["label", "action_type"],
      "properties": {
        "label": { "type": "string" },
        "action_type": { "enum": ["accept", "request_evidence", "request_recheck", "reject", "follow_up", "human_confirm_then_archive"] },
        "reason": { "type": "string" }
      },
      "additionalProperties": true
    },
    "ministry_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["department_id", "department_name", "signal", "verdict", "one_sentence"],
        "properties": {
          "department_id": { "type": "string" },
          "department_name": { "type": "string" },
          "signal": { "enum": ["GREEN", "YELLOW", "RED", "GRAY"] },
          "verdict": { "enum": ["APPROVE", "NEED_EVIDENCE", "RECHECK", "REJECT"] },
          "one_sentence": { "type": "string" },
          "source_label": { "$ref": "#/$defs/source_label" }
        },
        "additionalProperties": true
      }
    },
    "department_summaries": { "type": "array", "items": { "$ref": "DepartmentOpinionV1.json" } },
    "evidence_chain": { "type": "array", "items": { "$ref": "EvidenceItemV1.json" } },
    "missing_evidence": { "type": "array", "items": { "type": "string" } },
    "risk_register": { "type": "array", "items": { "type": "string" } },
    "conflicts": { "type": "array", "items": { "$ref": "ConflictSummaryV1.json" } },
    "red_blue_highlights": { "type": "array", "items": { "type": "string" } },
    "swarm_brief": { "$ref": "SwarmBriefV1.json" },
    "yushitai_audit": { "$ref": "QualityGateResultV1.json" },
    "quality_gate": { "$ref": "QualityGateResultV1.json" },
    "decision_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "enabled"],
        "properties": {
          "id": { "enum": ["accept", "request_evidence", "request_recheck", "reject", "follow_up", "human_confirm_then_archive"] },
          "label": { "type": "string" },
          "enabled": { "type": "boolean" },
          "disabled_reason": { "type": "string" },
          "requires_human_confirmation": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "downloadable_artifacts": { "$ref": "ReportDownloadManifestV1.json" },
    "archive_info": {
      "type": "object",
      "required": ["archivable", "archive_mode"],
      "properties": {
        "archivable": { "type": "boolean" },
        "archive_mode": { "enum": ["final", "pre_archive", "blocked"] },
        "archive_id": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": true
    },
    "needs_human_confirmation": { "type": "boolean" },
    "confidence": { "enum": ["高", "中", "低"] },
    "source_label": { "$ref": "#/$defs/source_label" }
  },
  "$defs": {
    "source_label": { "enum": ["LIVE", "LIVE_SWARM", "MIXED", "FALLBACK", "DEMO"] }
  },
  "additionalProperties": true
}
