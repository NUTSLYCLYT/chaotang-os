{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HubuQualityGateResultV1",
  "type": "object",
  "required": [
    "passed",
    "blocking_issues",
    "warnings",
    "required_actions",
    "source_label"
  ],
  "properties": {
    "passed": { "type": "boolean" },
    "signal": { "enum": ["GREEN", "YELLOW", "RED", "GRAY"] },
    "verdict": { "enum": ["APPROVE", "NEED_EVIDENCE", "RECHECK", "REJECT"] },
    "blocking_issues": {
      "type": "array",
      "items": { "type": "string" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source_label": {
      "enum": ["LIVE", "LIVE_SWARM", "MIXED", "FALLBACK", "DEMO"]
    }
  },
  "additionalProperties": false
}

