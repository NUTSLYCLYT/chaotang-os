{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RitesCMOCCOOpinionV1",
  "type": "object",
  "required": [
    "department",
    "position",
    "confidence",
    "executiveSummary",
    "brandCommsQuestionType",
    "audience",
    "goal",
    "channel",
    "messageRiskLevel",
    "keyMessages",
    "subOfficeOpinions",
    "generatedArtifacts",
    "evidenceUsed",
    "missingEvidence",
    "forbiddenExpressions",
    "requiredCrossReviews",
    "riskRegister",
    "nextBestAction",
    "highRiskRequiresHumanConfirmation",
    "mayPublish",
    "archiveReady",
    "sourceLabel",
    "source_label"
  ],
  "properties": {
    "department": { "const": "礼部" },
    "position": { "enum": ["可作为草稿", "先改稿", "补证", "复核", "禁止外发"] },
    "confidence": { "enum": ["高", "中", "低"] },
    "executiveSummary": { "type": "string" },
    "brandCommsQuestionType": {
      "enum": [
        "客户回复",
        "销售话术",
        "招商材料",
        "品牌定位",
        "官网/宣传资料",
        "公关媒体",
        "危机沟通",
        "竞品回应",
        "正式报价表达",
        "客户案例授权",
        "AI生成内容审查",
        "其他品牌传播问题"
      ]
    },
    "audience": { "type": "string" },
    "goal": { "type": "string" },
    "channel": { "type": "string" },
    "messageRiskLevel": { "enum": ["LOW", "MEDIUM", "HIGH", "BLOCKED"] },
    "keyMessages": { "type": "array", "items": { "type": "string" } },
    "subOfficeOpinions": { "type": "array", "items": { "$ref": "RitesSubOfficeReviewV1.json" } },
    "generatedArtifacts": { "type": "array", "items": { "$ref": "RitesGeneratedArtifactV1.json" } },
    "evidenceUsed": { "type": "array", "items": { "type": "string" } },
    "missingEvidence": { "type": "array", "items": { "type": "string" } },
    "forbiddenExpressions": { "type": "array", "items": { "type": "string" } },
    "requiredCrossReviews": {
      "type": "array",
      "items": { "enum": ["户部", "刑部", "兵部", "锦衣卫", "吏部", "工部", "军机处", "隐私权限检查", "人工确认"] }
    },
    "riskRegister": { "type": "array", "items": { "type": "string" } },
    "nextBestAction": { "type": "string" },
    "highRiskRequiresHumanConfirmation": { "type": "boolean" },
    "mayPublish": { "const": false },
    "archiveReady": { "type": "boolean" },
    "sourceLabel": { "enum": ["LIVE", "LIVE_SWARM", "MIXED", "FALLBACK", "DEMO"] },
    "source_label": { "enum": ["LIVE", "LIVE_SWARM", "MIXED", "FALLBACK", "DEMO"] }
  },
  "additionalProperties": false
}
