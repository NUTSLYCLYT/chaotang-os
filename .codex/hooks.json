{
  "description": "Repository skill preflight and completion gates.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/skill-preflight.mjs\"",
            "commandWindows": "cmd /d /s /c \"for /f \\\"delims=\\\" %R in ('git rev-parse --show-toplevel') do @node \\\"%R\\.codex\\hooks\\skill-preflight.mjs\\\"\"",
            "timeout": 10,
            "statusMessage": "Loading mandatory skill preflight"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/check-harness.mjs"
          }
        ]
      }
    ]
  }
}
