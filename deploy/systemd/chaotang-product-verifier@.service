[Unit]
Description=Chaotang Product Authority credential-separated verifier instance %i
Documentation=file:/opt/chaotang-product-verifier/test_chaotang_product_verifier_broker.py
StartLimitIntervalSec=60s
StartLimitBurst=4

[Service]
Type=exec
User=root
Group=root
RootDirectory=/var/lib/chaotang-product-verifier/privileged-runtime/rootfs
MountAPIVFS=yes
PrivateMounts=yes
ExecStart=/runtime/bin/python3 -I -B /opt/chaotang-product-verifier/chaotang-product-verifier-broker.py --serve-stdio
StandardInput=socket
StandardOutput=socket
StandardError=journal
Environment=HOME=/nonexistent
Environment=PATH=/runtime/bin
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=NO_COLOR=1
UMask=0077
RuntimeDirectory=chaotang-product-verifier/%i
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no

BindReadOnlyPaths=/opt/chaotang-product-verifier:/opt/chaotang-product-verifier
BindReadOnlyPaths=/etc/chaotang-product-verifier/installation.json:/run/chaotang-installation/installation.json
BindReadOnlyPaths=/etc/systemd/system/chaotang-product-verifier.socket:/run/chaotang-installation/socket.unit
BindReadOnlyPaths=/etc/systemd/system/chaotang-product-verifier@.service:/run/chaotang-installation/service.unit
BindReadOnlyPaths=/var/lib/chaotang-product-verifier/privileged-runtime/manifest.json:/run/chaotang-installation/privileged-profile.json
BindReadOnlyPaths=/var/lib/chaotang-product-verifier/runtime-profiles:/profiles
TemporaryFileSystem=/tmp:rw,nosuid,nodev,noexec,size=6G
InaccessiblePaths=-/home
InaccessiblePaths=-/mnt
InaccessiblePaths=-/media

CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_KILL CAP_SETGID CAP_SETUID
AmbientCapabilities=
NoNewPrivileges=no
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallArchitectures=native

KillMode=control-group
SendSIGKILL=yes
OOMPolicy=kill
Restart=no
MemoryMax=10G
MemorySwapMax=0
TasksMax=1024
CPUQuota=800%
LimitNOFILE=4096
LimitFSIZE=10G
# 30s setup + 30s ingest + 30s snapshot + 630s launcher/gate +
# 30s cleanup + a worst-case 30s recovery cleanup + 5s response + 15s stop margin.
RuntimeMaxSec=800
TimeoutStartSec=30
TimeoutStopSec=15
