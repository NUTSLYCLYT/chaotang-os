{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaotang-os.local/contracts/execution-authority-ext-attestation.schema.json",
  "title": "execution-authority.ext.v1 signed attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "payload", "signature"],
  "properties": {
    "schema_version": { "const": "execution-authority.ext.signed-attestation.v1" },
    "payload": { "$ref": "#/$defs/payload" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "identifier": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "authority_id", "task_id", "repository_identity", "grant_digest",
        "candidate_commit", "candidate_tree", "candidate_parent", "diff_name_status_z_digest",
        "lockfile_digest", "command_matrix_digest", "rounds_digest", "egress_policy_identity",
        "egress_policy_digest", "review_verdict_digest", "evidence_index_digest",
        "required_check_proof", "key_id", "issued_at"
      ],
      "properties": {
        "schema_version": { "const": "execution-authority.ext.attestation.v1" },
        "authority_id": { "const": "execution-authority.ext.v1" },
        "task_id": { "const": "EXT-GOV-AUTH-V1-20260815" },
        "repository_identity": { "const": "gitee.com/msxn/chaotang-os" },
        "grant_digest": { "$ref": "#/$defs/digest" },
        "candidate_commit": { "$ref": "#/$defs/sha" },
        "candidate_tree": { "$ref": "#/$defs/sha" },
        "candidate_parent": { "const": "017d3d34d0a56257fbbcdbd86cd6f1f6d9d0bcdd" },
        "diff_name_status_z_digest": { "$ref": "#/$defs/digest" },
        "lockfile_digest": { "$ref": "#/$defs/digest" },
        "command_matrix_digest": { "$ref": "#/$defs/digest" },
        "rounds_digest": { "$ref": "#/$defs/digest" },
        "egress_policy_identity": { "$ref": "#/$defs/identifier" },
        "egress_policy_digest": { "$ref": "#/$defs/digest" },
        "review_verdict_digest": { "$ref": "#/$defs/digest" },
        "evidence_index_digest": { "$ref": "#/$defs/digest" },
        "required_check_proof": { "$ref": "#/$defs/platform_proof_envelope" },
        "key_id": { "$ref": "#/$defs/identifier" },
        "issued_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "key_id": { "$ref": "#/$defs/identifier" },
        "value": { "type": "string", "minLength": 86, "maxLength": 86, "pattern": "^[A-Za-z0-9_-]+$" }
      }
    },
    "platform_proof_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "payload", "signature"],
      "properties": {
        "schema_version": { "const": "execution-authority.ext.signed-platform-proof.v1" },
        "payload": { "$ref": "#/$defs/platform_proof_payload" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    },
    "platform_proof_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "authority_id", "repository_identity", "protected_branch", "candidate_commit",
        "check_name", "check_result", "protection_enforced", "policy_identity", "policy_digest",
        "rule_revision", "observed_at", "key_id"
      ],
      "properties": {
        "schema_version": { "const": "execution-authority.ext.platform-proof.v1" },
        "authority_id": { "const": "execution-authority.ext.v1" },
        "repository_identity": { "const": "gitee.com/msxn/chaotang-os" },
        "protected_branch": { "const": "ext-dev" },
        "candidate_commit": { "$ref": "#/$defs/sha" },
        "check_name": { "$ref": "#/$defs/identifier" },
        "check_result": { "const": "SUCCESS" },
        "protection_enforced": { "const": true },
        "policy_identity": { "$ref": "#/$defs/identifier" },
        "policy_digest": { "$ref": "#/$defs/digest" },
        "rule_revision": { "$ref": "#/$defs/identifier" },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "key_id": { "$ref": "#/$defs/identifier" }
      }
    }
  }
}
