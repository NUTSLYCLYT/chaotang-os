{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaotang-os.invalid/contracts/six-ministry-capability-execution.schema.json",
  "title": "Chaotang Capability Protocol V1 compatibility envelope",
  "description": "Strict non-authoritative protocol over the existing server-owned RuntimeSkill execution envelope and an inert Capsule-bound candidate projection. Neither branch creates authority.",
  "oneOf": [
    { "$ref": "#/$defs/runtimeSkillEnvelope" },
    { "$ref": "#/$defs/capsuleBoundEnvelope" }
  ],
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 256 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "capabilityId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1, "maxLength": 128 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "uniqueTexts": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "capabilityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "version", "capsule_digest"],
      "properties": {
        "capability_id": { "$ref": "#/$defs/capabilityId" },
        "version": { "$ref": "#/$defs/version" },
        "capsule_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "boundedRefs": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/capabilityRef" } },
    "runtimeSkillEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "contract_role", "runtime_skill_binding", "identity", "routing", "evidence", "responsibility", "execution", "tool_policy", "outcome"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "contract_role": { "const": "runtime-skill-compatibility-overlay-not-authority" },
        "runtime_skill_binding": { "$ref": "#/$defs/runtimeSkillBinding" },
        "identity": { "$ref": "#/$defs/identity" },
        "routing": { "$ref": "#/$defs/routing" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "responsibility": { "$ref": "#/$defs/responsibility" },
        "execution": { "$ref": "#/$defs/execution" },
        "tool_policy": { "$ref": "#/$defs/toolPolicy" },
        "outcome": { "$ref": "#/$defs/runtimeOutcome" }
      },
      "allOf": [
        {
          "if": { "properties": { "routing": { "properties": { "mode": { "const": "multi" } }, "required": ["mode"] } } },
          "then": { "properties": { "routing": { "properties": { "ministries": { "minItems": 2 }, "joint_review": { "properties": { "required": { "const": true }, "status": { "const": "COMPLETED" }, "reviewer": { "const": "junjichu" }, "receipt_ref": { "$ref": "#/$defs/text" } } } } } } }
        },
        {
          "if": { "properties": { "execution": { "properties": { "phase": { "const": "PREVIEW" } } } } },
          "then": { "properties": { "tool_policy": { "not": { "properties": { "decision": { "const": "ALLOW_EXECUTE" } }, "required": ["decision"] } } } }
        },
        {
          "if": { "properties": { "outcome": { "properties": { "status": { "enum": ["BLOCKED", "FAILED"] } } } } },
          "then": { "properties": { "tool_policy": { "properties": { "decision": { "const": "DENY" } } } } }
        },
        {
          "if": { "properties": { "evidence": { "properties": { "status": { "enum": ["PARTIAL", "BLOCKED", "UNAVAILABLE"] } } } } },
          "then": { "properties": { "outcome": { "not": { "properties": { "status": { "const": "READY" } }, "required": ["status"] } } } }
        },
        {
          "if": { "properties": { "execution": { "properties": { "phase": { "const": "EXECUTE" }, "side_effect_class": { "enum": ["EXTERNAL_WRITE", "IRREVERSIBLE"] } } } } },
          "then": { "properties": { "execution": { "properties": { "human_confirmation": { "properties": { "required": { "const": true }, "status": { "const": "CONFIRMED" }, "receipt_ref": { "$ref": "#/$defs/text" } } } } } } }
        }
      ]
    },
    "capsuleBoundEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "contract_role", "capability_binding", "principal_binding", "capability_view", "security_projection", "outcome"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "contract_role": { "const": "capability-capsule-binding-candidate-not-authority" },
        "capability_binding": { "$ref": "#/$defs/capabilityBinding" },
        "principal_binding": { "$ref": "#/$defs/principalBinding" },
        "capability_view": { "$ref": "#/$defs/capabilityView" },
        "security_projection": { "$ref": "#/$defs/securityProjection" },
        "outcome": { "$ref": "#/$defs/capsuleOutcome" }
      }
    },
    "capabilityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "version", "capsule_digest", "lock_digest", "projection_digest", "mapping_status"],
      "properties": {
        "capability_id": { "$ref": "#/$defs/capabilityId" },
        "version": { "$ref": "#/$defs/version" },
        "capsule_digest": { "$ref": "#/$defs/digest" },
        "lock_digest": { "$ref": "#/$defs/digest" },
        "projection_digest": { "$ref": "#/$defs/digest" },
        "mapping_status": { "const": "UNRESOLVED" }
      }
    },
    "principalBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "tenant_principal_ref", "owner_membership_ref", "run_ref"],
      "properties": {
        "status": { "const": "UNRESOLVED" },
        "tenant_principal_ref": { "type": "null" },
        "owner_membership_ref": { "type": "null" },
        "run_ref": { "type": "null" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": { "from": { "$ref": "#/$defs/text" }, "to": { "$ref": "#/$defs/text" } }
    },
    "capabilityView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "resolution_status", "decision", "refs", "edges", "budget"],
      "properties": {
        "type": { "enum": ["Tool", "Skill", "Agent", "Workflow", "Swarm", "Expert", "Pack"] },
        "resolution_status": { "enum": ["UNRESOLVED", "CAPSULE_REFS_ONLY"] },
        "decision": { "const": "DENY" },
        "refs": { "$ref": "#/$defs/boundedRefs" },
        "edges": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/edge" } },
        "budget": { "type": "integer", "minimum": 1, "maximum": 32 }
      },
      "allOf": [
        { "if": { "properties": { "type": { "enum": ["Tool", "Skill", "Agent", "Workflow", "Swarm", "Expert"] } }, "required": ["type"] }, "then": { "properties": { "resolution_status": { "const": "UNRESOLVED" }, "refs": { "maxItems": 0 }, "edges": { "maxItems": 0 } } } },
        { "if": { "properties": { "type": { "const": "Pack" } }, "required": ["type"] }, "then": { "properties": { "resolution_status": { "const": "CAPSULE_REFS_ONLY" }, "refs": { "minItems": 1 }, "edges": { "maxItems": 0 } } } }
      ]
    },
    "securityProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle", "execution_authority", "external_effects", "publisher_status", "sbom_status", "qualified_use", "activation", "durable_receipt", "revocation_epoch_status", "mcp_status", "mcp_decision", "mcp_refs", "a2a_status", "a2a_decision"],
      "properties": {
        "lifecycle": { "const": "CANDIDATE_ONLY" },
        "execution_authority": { "const": "NONE" },
        "external_effects": { "const": false },
        "publisher_status": { "const": "UNVERIFIED" },
        "sbom_status": { "const": "UNVERIFIED" },
        "qualified_use": { "const": "NOT_MEASURED" },
        "activation": { "const": "DENY" },
        "durable_receipt": { "const": "ABSENT" },
        "revocation_epoch_status": { "const": "UNAVAILABLE" },
        "mcp_status": { "const": "UNAVAILABLE" },
        "mcp_decision": { "const": "DENY" },
        "mcp_refs": { "type": "array", "maxItems": 0 },
        "a2a_status": { "const": "UNSUPPORTED" },
        "a2a_decision": { "const": "DENY" }
      }
    },
    "capsuleOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_codes"],
      "properties": {
        "status": { "const": "NO_EXECUTION_AUTHORITY" },
        "reason_codes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "prefixItems": [
            { "const": "candidate_only" },
            { "const": "exact_zero_grant" },
            { "const": "mapping_unresolved" }
          ],
          "items": false
        }
      }
    },
    "runtimeSkillBinding": { "type": "object", "additionalProperties": false, "required": ["skill_id", "definition_version", "authority_source", "registry_source", "definition_digest"], "properties": { "skill_id": { "$ref": "#/$defs/text" }, "definition_version": { "$ref": "#/$defs/text" }, "authority_source": { "const": "backend/app/agents/runtime_skills/models.py" }, "registry_source": { "const": "backend/app/agents/runtime_skills/registry.py" }, "definition_digest": { "$ref": "#/$defs/digest" } } },
    "identity": { "type": "object", "additionalProperties": false, "required": ["tenant_id", "owner_user_id", "run_id"], "properties": { "tenant_id": { "$ref": "#/$defs/text" }, "owner_user_id": { "$ref": "#/$defs/text" }, "run_id": { "$ref": "#/$defs/text" } } },
    "jointReview": { "type": "object", "additionalProperties": false, "required": ["required", "status", "reviewer", "receipt_ref"], "properties": { "required": { "type": "boolean" }, "status": { "enum": ["NOT_REQUIRED", "PENDING", "COMPLETED", "FAILED"] }, "reviewer": { "enum": ["none", "junjichu"] }, "receipt_ref": { "type": ["string", "null"], "minLength": 1, "maxLength": 256 } } },
    "routing": { "type": "object", "additionalProperties": false, "required": ["mode", "ministries", "joint_review"], "properties": { "mode": { "enum": ["single", "multi"] }, "ministries": { "$ref": "#/$defs/uniqueTexts" }, "joint_review": { "$ref": "#/$defs/jointReview" } } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["snapshot_ref", "status", "adopted_evidence_ids", "missing_evidence"], "properties": { "snapshot_ref": { "$ref": "#/$defs/text" }, "status": { "enum": ["RESOLVED", "PARTIAL", "BLOCKED", "UNAVAILABLE"] }, "adopted_evidence_ids": { "$ref": "#/$defs/uniqueTexts" }, "missing_evidence": { "$ref": "#/$defs/uniqueTexts" } } },
    "responsibility": { "type": "object", "additionalProperties": false, "required": ["accountable_ministry", "responsible_bureaus", "authority_projection_ref"], "properties": { "accountable_ministry": { "$ref": "#/$defs/text" }, "responsible_bureaus": { "$ref": "#/$defs/uniqueTexts" }, "authority_projection_ref": { "$ref": "#/$defs/text" } } },
    "humanConfirmation": { "type": "object", "additionalProperties": false, "required": ["required", "status", "work_product_ref", "receipt_ref"], "properties": { "required": { "type": "boolean" }, "status": { "enum": ["NOT_REQUIRED", "PENDING", "CONFIRMED", "REVISION_REQUIRED", "ESCALATED"] }, "work_product_ref": { "$ref": "#/$defs/text" }, "receipt_ref": { "type": ["string", "null"], "minLength": 1, "maxLength": 256 } } },
    "execution": { "type": "object", "additionalProperties": false, "required": ["phase", "side_effect_class", "preview_digest", "human_confirmation"], "properties": { "phase": { "enum": ["PREVIEW", "EXECUTE"] }, "side_effect_class": { "enum": ["NONE", "INTERNAL_REVERSIBLE", "EXTERNAL_WRITE", "IRREVERSIBLE"] }, "preview_digest": { "$ref": "#/$defs/digest" }, "human_confirmation": { "$ref": "#/$defs/humanConfirmation" } } },
    "toolPolicy": { "type": "object", "additionalProperties": false, "required": ["policy_ref", "requested_tool_ids", "decision", "decision_receipt_ref"], "properties": { "policy_ref": { "$ref": "#/$defs/text" }, "requested_tool_ids": { "$ref": "#/$defs/uniqueTexts" }, "decision": { "enum": ["DENY", "ALLOW_PREVIEW", "ALLOW_EXECUTE"] }, "decision_receipt_ref": { "type": ["string", "null"], "minLength": 1, "maxLength": 256 } } },
    "runtimeOutcome": { "type": "object", "additionalProperties": false, "required": ["status", "reason_codes", "retryable"], "properties": { "status": { "enum": ["READY", "DEGRADED", "BLOCKED", "FAILED"] }, "reason_codes": { "$ref": "#/$defs/uniqueTexts" }, "retryable": { "type": "boolean" } } }
  }
}
