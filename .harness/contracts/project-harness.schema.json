{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaotang-os.local/contracts/ext-project-harness.v1.schema.json",
  "title": "Chaotang OS ext project harness observation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "root",
    "frontend",
    "backend",
    "observedAuthority",
    "productAuthority",
    "scenePackExecutionAuthority",
    "governanceGrantState"
  ],
  "properties": {
    "schemaVersion": { "const": "ext-project-harness.v1" },
    "status": { "const": "BOOTSTRAP_OBSERVE" },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "entrypoint", "harnessRoot", "manifest", "doctor"],
      "properties": {
        "status": { "const": "READY_FOR_OBSERVE" },
        "entrypoint": { "const": "AGENTS.md" },
        "harnessRoot": { "const": ".harness" },
        "manifest": { "const": ".harness/manifest/project-harness.json" },
        "doctor": { "const": "scripts/harness-doctor.mjs" }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "entrypoint", "harnessRoot", "manifest", "doctor"],
      "properties": {
        "status": { "const": "ABSENT" },
        "entrypoint": { "const": "frontend/AGENTS.md" },
        "harnessRoot": { "const": "frontend/.harness" },
        "manifest": { "type": "null" },
        "doctor": { "type": "null" }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "entrypoint", "harnessRoot", "manifest", "doctor"],
      "properties": {
        "status": { "const": "PARTIAL" },
        "entrypoint": { "const": "backend/AGENTS.md" },
        "harnessRoot": { "const": "backend/harness" },
        "manifest": { "type": "null" },
        "doctor": { "type": "null" }
      }
    },
    "observedAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "decision", "canExecuteProductWork"],
      "properties": {
        "namespace": { "const": "execution-authority.ext.v1" },
        "decision": { "const": "STOP" },
        "canExecuteProductWork": { "const": false }
      }
    },
    "productAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "status",
        "consumer",
        "approvalSchema",
        "decision",
        "canExecuteProductWork"
      ],
      "properties": {
        "namespace": { "const": "product-authority.m0.v1" },
        "status": { "const": "CONSUMER_AVAILABLE" },
        "consumer": { "const": "scripts/product-authority.mjs" },
        "approvalSchema": { "const": ".harness/contracts/product-approval.schema.json" },
        "decision": { "const": "STOP" },
        "canExecuteProductWork": { "const": false }
      }
    },
    "scenePackExecutionAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "manifest",
        "schema",
        "resolver",
        "command",
        "test",
        "documentation",
        "verification"
      ],
      "properties": {
        "status": { "const": "APPROVED_FOR_SCENE_PACK_V1" },
        "manifest": { "const": ".harness/manifest/execution-authority.scene-pack-v1.json" },
        "schema": { "const": ".harness/contracts/execution-authority-scene-pack-v1.schema.json" },
        "resolver": { "const": "scripts/lib/execution-authority-scene-pack-v1.mjs" },
        "command": { "const": "scripts/execution-authority-scene-pack-v1.mjs" },
        "test": { "const": "scripts/execution-authority-scene-pack-v1.nodetest.mjs" },
        "documentation": { "const": ".harness/wiki/execution-authority-scene-pack-v1.md" },
        "verification": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "string" }
        }
      }
    },
    "governanceGrantState": { "const": "EXTERNAL_NOT_CONSUMED" }
  }
}
