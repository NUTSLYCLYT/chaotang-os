{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaotang.local/harness/task.schema.json",
  "title": "Multi-agent task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "title", "status", "owner", "scope", "dependencies", "created_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "pattern": "^task-[A-Za-z0-9._-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["draft", "ready", "leased", "running", "blocked", "review", "completed", "cancelled"] },
    "owner": { "type": "string", "minLength": 1 },
    "scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^task-[A-Za-z0-9._-]+$" } },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$" },
    "updated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$" },
    "metadata": { "type": "object" }
  }
}
