{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaotang.local/harness/task.schema.json",
  "title": "Multi-agent task", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "task_id", "title", "status", "owner", "read_paths", "write_paths", "resources", "dependencies", "worktree", "risk", "created_at", "expires_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "pattern": "^task-[A-Za-z0-9._-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "ready", "leased", "running", "blocked", "review", "completed", "cancelled"] },
    "owner": { "type": "string", "minLength": 1 },
    "read_paths": { "$ref": "#/$defs/paths" }, "write_paths": { "$ref": "#/$defs/paths" },
    "resources": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^(port:(3002|3050)|build:[A-Za-z0-9._-]+|release:[A-Za-z0-9._-]+|integration:[A-Za-z0-9._-]+)$" } },
    "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^task-[A-Za-z0-9._-]+$" } },
    "worktree": { "type": "string", "minLength": 1 },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "created_at": { "type": "string", "format": "date-time" }, "expires_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }, "metadata": { "type": "object" }
  },
  "$defs": { "paths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[*?\\[\\]{}]).+$" } } }
}
