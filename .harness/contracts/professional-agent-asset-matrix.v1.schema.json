{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EXT professional Agent asset matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "matrixId",
    "canonicalOwner",
    "integrationTarget",
    "provenance",
    "inventoryAssertions",
    "assets"
  ],
  "properties": {
    "schemaVersion": { "const": "professional-agent-asset-matrix.v1" },
    "matrixId": { "const": "professional-agent-assets-ext-k0" },
    "canonicalOwner": { "const": "feature-chaotang-ext" },
    "integrationTarget": { "const": "backend/src" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetFamily", "decision", "donorBranch", "donorTip", "candidateCommits", "adaptation"],
      "properties": {
        "assetFamily": { "const": "PROFESSIONAL_AGENT_K0" },
        "decision": { "const": "ABSORB_ADAPT" },
        "donorBranch": { "const": "codex/professional-agent-k0-20260803" },
        "donorTip": { "const": "675aa950a073ae4e3e72b562aab13eea43d018df" },
        "candidateCommits": {
          "type": "array",
          "uniqueItems": true,
          "const": [
            "a6c391cbda1217a392009c8bc51eed159cdd3464",
            "4c55ad785540463edb16860d5302f77480d2e381",
            "675aa950a073ae4e3e72b562aab13eea43d018df"
          ]
        },
        "adaptation": { "const": "REBUILT_ON_CURRENT_EXT" }
      }
    },
    "inventoryAssertions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/inventoryAssertion" }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "safePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/\\u4e00-\\u9fff-]+$"
    },
    "inventoryAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "root", "fileName", "expectedCount"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "root": { "$ref": "#/$defs/safePath" },
        "fileName": { "type": "string", "minLength": 1 },
        "expectedCount": { "type": "integer", "minimum": 1 }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "title",
        "owner",
        "kind",
        "maturity",
        "capabilities",
        "runtimeEntries",
        "apiEntries",
        "contractEntries",
        "promptEntries",
        "designEntries",
        "toolEntries",
        "testEntries",
        "coverageStatus",
        "gapReason",
        "verificationCommand",
        "sourceDisposition"
      ],
      "properties": {
        "assetId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "owner": { "enum": ["root", "backend"] },
        "kind": { "enum": ["CANONICAL_REGISTRY", "RUNTIME_AGENT", "ROLE_COLLECTION"] },
        "maturity": { "enum": ["DESIGN_ONLY", "PROMPT_ONLY", "CONTRACT_READY", "API_READY", "LIVE"] },
        "capabilities": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "runtimeEntries": { "$ref": "#/$defs/pathList" },
        "apiEntries": { "$ref": "#/$defs/pathList" },
        "contractEntries": { "$ref": "#/$defs/pathList" },
        "promptEntries": { "$ref": "#/$defs/pathList" },
        "designEntries": { "$ref": "#/$defs/pathList" },
        "toolEntries": { "$ref": "#/$defs/pathList" },
        "testEntries": { "$ref": "#/$defs/pathList" },
        "coverageStatus": { "enum": ["VERIFIED", "PARTIAL"] },
        "gapReason": { "type": ["string", "null"] },
        "verificationCommand": { "type": "string", "minLength": 1 },
        "sourceDisposition": { "enum": ["CURRENT_CANONICAL", "CURRENT_WITH_GAPS"] }
      }
    },
    "pathList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/safePath" }
    }
  }
}
