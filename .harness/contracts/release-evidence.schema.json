{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaotang.local/harness/release-evidence.schema.json",
  "title": "Release evidence envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "commit_sha", "status", "commander_lease_id", "build_digest", "evidence_digest", "started_at", "completed_at", "checks"],
  "properties": {
    "schema_version": { "const": 1 },
    "release_id": { "type": "string", "pattern": "^release-[A-Za-z0-9._-]+$" },
    "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "status": { "type": "string", "enum": ["verified", "rejected", "rolled_back"] },
    "commander_lease_id": { "type": "string", "pattern": "^lease-[A-Za-z0-9._-]+$" },
    "build_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "evidence_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "started_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$" },
    "completed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$" },
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["passed", "failed", "skipped"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
