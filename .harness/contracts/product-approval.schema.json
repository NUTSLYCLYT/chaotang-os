{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaotang-os.local/contracts/product-authority.m0.approval.v1-v2.schema.json",
  "title": "Chaotang OS M0 solo-owner product approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "authorityId", "taskId", "repository", "request", "nonGoals", "verification", "state"],
  "properties": {
    "schemaVersion": { "enum": ["product-authority.m0.approval.v1", "product-authority.m0.approval.v2"] },
    "authorityId": { "const": "product-authority.m0.v1" },
    "taskId": { "$ref": "#/$defs/taskId" },
    "repository": { "$ref": "#/$defs/repository" },
    "request": { "$ref": "#/$defs/request" },
    "nonGoals": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[A-Z][A-Z0-9_]+$" }
    },
    "verification": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/verification" } },
    "preAuthorizationReceipt": { "$ref": "#/$defs/preAuthorizationReceipt" },
    "state": { "const": "APPROVED_FOR_ONE_CHILD" }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": "product-authority.m0.approval.v1" } } },
      "then": { "not": { "required": ["preAuthorizationReceipt"] } }
    },
    {
      "if": { "properties": { "schemaVersion": { "const": "product-authority.m0.approval.v2" } } },
      "then": { "required": ["preAuthorizationReceipt"] }
    }
  ],
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "taskId": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[A-Z0-9][A-Z0-9._-]+$" },
    "identifier": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$" },
    "repoPath": {
      "type": "string", "minLength": 1, "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\u0000-\\u001F\\u007F\\\\*?])[^/]+(?:/[^/]+)*$"
    },
    "repository": {
      "type": "object", "additionalProperties": false, "required": ["identity", "targetBranch"],
      "properties": {
        "identity": { "const": "gitee.com/msxn/chaotang-os" },
        "targetBranch": { "const": "ext-dev" }
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["baseCommit", "baseTree", "approvalPath", "approvalCommitPaths", "productPaths"],
      "properties": {
        "baseCommit": { "$ref": "#/$defs/sha" },
        "baseTree": { "$ref": "#/$defs/sha" },
        "approvalPath": { "$ref": "#/$defs/repoPath" },
        "approvalCommitPaths": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/repoPath" } },
        "productPaths": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/repoPath" } }
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false, "required": ["id", "tool", "args", "cwd", "timeoutMs"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "tool": { "enum": ["node", "npm", "python3"] },
        "args": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 4096 } },
        "cwd": {
          "type": "string", "minLength": 1, "maxLength": 512,
          "pattern": "^(?:\\.|(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\u0000-\\u001F\\u007F\\\\*?])[^/]+(?:/[^/]+)*)$"
        },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 }
      }
    },
    "sourceIdentity": {
      "type": "object", "additionalProperties": false, "required": ["bytes", "gitBlobSha1", "mode", "rawSha256"],
      "properties": {
        "bytes": { "type": "integer", "minimum": 1 },
        "gitBlobSha1": { "$ref": "#/$defs/sha1" },
        "mode": { "const": "100644" },
        "rawSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "pathBindingCase": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "stage", "target", "attack", "observedStop", "cleanup", "externalSentinel"],
      "properties": {
        "id": { "type": "string", "minLength": 3, "maxLength": 128 },
        "stage": { "enum": ["mkdir", "mount", "copy", "remount", "cleanup"] },
        "target": { "enum": ["home-ancestor", "target"] },
        "attack": { "enum": ["rename-directory-replacement", "symlink-replacement"] },
        "observedStop": { "const": "VERIFICATION_PATH_IDENTITY_DRIFT" },
        "cleanup": { "const": "PASS" },
        "externalSentinel": { "const": "UNCHANGED" }
      }
    },
    "pathBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "recordBytes", "recordDigest", "schemaBytes", "schemaDigest", "caseCount", "orderedCases"],
      "properties": {
        "schemaVersion": { "const": "chaotang.path-binding-self-test.attestation.v1" },
        "recordBytes": { "const": 4123 },
        "recordDigest": { "const": "sha256:7ba1eeb23769551d2be58f136c1038e8897f5141755f5a34ac2cf0c39fa0c572" },
        "schemaBytes": { "const": 8475 },
        "schemaDigest": { "const": "sha256:9afc472beb987bfe1c233e61f3247a5f509d52aa37d375f124cb451a3ccdf049" },
        "caseCount": { "const": 18 },
        "orderedCases": { "type": "array", "minItems": 18, "maxItems": 18, "items": { "$ref": "#/$defs/pathBindingCase" } }
      }
    },
    "broker": {
      "type": "object", "additionalProperties": false,
      "required": ["socketPath", "runtimeProfileId", "runtimeProfileDigest", "installationManifestDigest", "dedicatedControllerManifestDigest", "executionProfileIdentity"],
      "properties": {
        "socketPath": { "const": "/run/chaotang-product-verifier/verifier.sock" },
        "runtimeProfileId": { "$ref": "#/$defs/identifier" },
        "runtimeProfileDigest": { "$ref": "#/$defs/sha256" },
        "installationManifestDigest": { "$ref": "#/$defs/sha256" },
        "dedicatedControllerManifestDigest": { "$ref": "#/$defs/sha256" },
        "executionProfileIdentity": { "$ref": "#/$defs/sourceIdentity" }
      }
    },
    "preAuthorizationReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "controllerVerificationId", "verifierVerificationId", "controllerIdentity", "verifierIdentity", "pathBinding", "broker", "ttlMs", "maxChallengeBytes", "maxReceiptBytes"],
      "properties": {
        "schemaVersion": { "const": "product-authority.m0.pre-authorization-policy.v2" },
        "controllerVerificationId": { "$ref": "#/$defs/identifier" },
        "verifierVerificationId": { "$ref": "#/$defs/identifier" },
        "controllerIdentity": { "$ref": "#/$defs/sourceIdentity" },
        "verifierIdentity": { "$ref": "#/$defs/sourceIdentity" },
        "pathBinding": { "$ref": "#/$defs/pathBinding" },
        "broker": { "$ref": "#/$defs/broker" },
        "ttlMs": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "maxChallengeBytes": { "const": 16384 },
        "maxReceiptBytes": { "const": 65536 }
      }
    }
  }
}
