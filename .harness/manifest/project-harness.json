{
  "version": 1,
  "root": {
    "entrypoints": ["AGENTS.md", "README.md", "scripts/harness-doctor.mjs", "scripts/new-change.mjs"],
    "harness": ".harness",
    "verification": ".harness/wiki/verification-matrix.md"
  },
  "frontend": {
    "path": "frontend",
    "entrypoints": ["frontend/AGENTS.md", "frontend/README.md"],
    "harness": "frontend/.harness",
    "doctor": "frontend/scripts/harness-doctor.mjs"
  },
  "backend": {
    "path": "backend",
    "entrypoints": ["backend/AGENTS.md", "backend/README.md"],
    "harnessRoot": "backend/harness",
    "harnessManifest": "backend/harness/manifest.json",
    "doctor": "backend/scripts/harness_doctor.py",
    "primaryHarnesses": [
      "chaotang-commercial-loop",
      "chaotang-true-loop",
      "chaotang_business_model",
      "chaotang_department_protocol",
      "chaotang_merit_system",
      "chaotang_uiux_system",
      "jinyiwei-scrapling-poc",
      "legal-redteam",
      "open_source_watch",
      "resource_consolidation",
      "swarm-tool-matrix",
      "yushi_global_gate"
    ],
    "implementationPackages": [
      "chaotang_department_personas",
      "chaotang_ui_user_skills",
      "gongbu_review",
      "jinyiwei_scrapling_poc",
      "legal_redteam"
    ],
    "allowedInfrastructureDirs": ["_shared", "changes"],
    "referenceArtifacts": [
      {
        "id": "agent_design",
        "path": "backend/agent_design",
        "required": ["README.md"]
      },
      {
        "id": "runtime_prompts",
        "path": "backend/runtime_prompts",
        "required": ["README.md"]
      }
    ]
  },
  "docs": {
    "path": "docs",
    "entrypoints": ["docs/README.md", "docs/product/PROJECT_PRODUCT.md"],
    "productDir": "docs/product"
  },
  "capabilityEntryGovernance": {
    "status": "OBSERVE",
    "documentation": ".harness/wiki/capability-entry-governance.md",
    "inventory": ".harness/manifest/capability-entry-inventory.json",
    "contracts": [
      ".harness/contracts/capability-entry.schema.json",
      ".harness/contracts/capability-entry-event.schema.json"
    ],
    "telemetry": {
      "eventName": "capability_entry_invoked.v1",
      "sink": "OWNER_DEFINED"
    },
    "deletionGate": {
      "minimumObservationDays": 14,
      "maximumInvocations": 0,
      "requireVerifiedReplacement": true
    },
    "verification": [
      "node --test scripts/capability-entry-governance.nodetest.mjs"
    ]
  },
  "controlPlane": {
    "status": "IMPLEMENTING",
    "rolloutStage": "s10-local-observe-pending",
    "blueprint": "docs/multi-agent-harness-control-plane-blueprint-2026-07-13.md",
    "documentation": ".harness/wiki/multi-agent-control-plane.md",
    "baseline": ".harness/baselines/multi-agent-control-plane-20260713.json",
    "testIdentityTrust": {
      "status": "EXTERNAL_REQUIRED",
      "keyId": null,
      "publicKeySha256": null,
      "runtimePublicKey": "trust/test-isolation/<key-id>.pem",
      "note": "Set PINNED values in a reviewed commit and provision the matching public key under git-common-dir; the private key belongs only to the external isolation provisioner."
    },
    "contracts": [
      ".harness/contracts/task.schema.json",
      ".harness/contracts/lease.schema.json",
      ".harness/contracts/release-run.schema.json",
      ".harness/contracts/release-evidence.schema.json"
    ],
    "components": {
      "contracts": "IMPLEMENTED", "taskRegistry": "IMPLEMENTED", "leaseManager": "IMPLEMENTED",
      "resourceLocks": "IMPLEMENTED", "leaseAttestation": "IMPLEMENTED_LOCAL", "integrationGate": "IMPLEMENTED_LOCAL", "worktreeManager": "IMPLEMENTED_LOCAL", "immutableBuilds": "IMPLEMENTED_LOCAL",
      "releaseCommander": "IMPLEMENTED_LOCAL", "testIdentity": "IMPLEMENTED_LOCAL", "releaseEvidence": "IMPLEMENTED_LOCAL",
      "recovery": "IMPLEMENTED_LOCAL", "mandatoryRollout": "IMPLEMENTED_LOCAL_OBSERVE_PENDING",
      "rolloutHistoryGate": "IMPLEMENTED_LOCAL"
    },
    "verification": [
      "node --test scripts/multi-agent-contracts.nodetest.mjs",
      "node --test scripts/multi-agent-lease.nodetest.mjs",
      "node --test scripts/resource-lock.nodetest.mjs",
      "node --test scripts/lease-attestation.nodetest.mjs",
      "node scripts/integration-lease-gate.mjs --status",
      "node --test scripts/worktree-manager.nodetest.mjs",
      "node --experimental-strip-types --test frontend/scripts/safe-prod-lifecycle.nodetest.ts",
      "node --test scripts/release-commander.nodetest.mjs",
      "node --test scripts/test-identity.nodetest.mjs",
      "node --test scripts/release-evidence.nodetest.mjs",
      "node --test scripts/recovery-drill.nodetest.mjs",
      "node --test scripts/rollout-controller.nodetest.mjs",
      "node --test scripts/rollout-watch.nodetest.mjs scripts/rollout-authority-integration.nodetest.mjs",
      "node scripts/rollout-control.mjs status",
      "node --test frontend/scripts/prod-runtime-identity.nodetest.ts",
      "python3 -m pytest -q backend/tests/test_production_has_no_test_identity_routes.py",
      "node scripts/harness-doctor.mjs"
    ]
  }
}
