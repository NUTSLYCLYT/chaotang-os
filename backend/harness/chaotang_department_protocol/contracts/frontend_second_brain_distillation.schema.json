{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaotang-os.local/schemas/frontend-second-brain-distillation.json",
  "title": "Frontend second-brain safety distillation cases",
  "type": "array",
  "minItems": 8,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["case_id", "input", "expected", "legacy_origins"],
    "properties": {
      "case_id": { "type": "string", "minLength": 1 },
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["raw_question", "source_label", "known_facts", "unknown_gaps"],
        "properties": {
          "raw_question": { "type": "string", "minLength": 1 },
          "source_label": { "enum": ["LIVE", "LIVE_SWARM", "MIXED", "FALLBACK", "DEMO"] },
          "known_facts": { "type": "array", "items": { "type": "string" } },
          "unknown_gaps": { "type": "array", "items": { "type": "string" } }
        }
      },
      "expected": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required_swarms", "allowed_verdicts", "forbidden_verdicts",
          "required_missing_evidence_any", "required_risk_tokens_any",
          "needs_human_confirmation", "conflict_visible", "decision_eligible",
          "required_provenance"
        ],
        "properties": {
          "required_swarms": { "type": "array", "items": { "type": "string" } },
          "allowed_verdicts": { "type": "array", "items": { "type": "string" } },
          "forbidden_verdicts": { "type": "array", "items": { "type": "string" } },
          "required_missing_evidence_any": { "type": "array", "items": { "type": "string" } },
          "required_risk_tokens_any": { "type": "array", "items": { "type": "string" } },
          "needs_human_confirmation": { "type": "boolean" },
          "conflict_visible": { "type": "boolean" },
          "decision_eligible": { "type": "boolean" },
          "required_provenance": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      },
      "legacy_origins": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "pattern": "\\.ts:[0-9]+" }
      }
    }
  }
}
