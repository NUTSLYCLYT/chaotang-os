{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://courtos.local/schemas/SwarmRoutePlanV1.json",
  "type": "object",
  "required": ["swarm_mode", "selected_swarms", "swarm_tasks", "expected_outputs", "source_label"],
  "properties": {
    "swarm_mode": { "enum": ["dry_run", "standard", "deep", "live_swarm"] },
    "selected_swarms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["swarm_id", "reason"],
        "properties": {
          "swarm_id": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "swarm_tasks": { "type": "array" },
    "expected_outputs": { "type": "array", "items": { "type": "string" } },
    "source_label": { "enum": ["LIVE", "LIVE_SWARM", "MIXED", "FALLBACK", "DEMO"] }
  }
}
