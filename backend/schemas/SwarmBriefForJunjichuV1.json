{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://courtos.local/schemas/SwarmBriefForJunjichuV1.json",
  "type": "object",
  "required": [
    "executive_summary",
    "department_sections",
    "evidence_chain",
    "risk_register",
    "missing_evidence",
    "conflict_summary",
    "recommended_next_action",
    "questions_for_emperor",
    "source_label"
  ],
  "properties": {
    "executive_summary": { "type": "string" },
    "department_sections": { "type": "array" },
    "evidence_chain": { "type": "array" },
    "risk_register": { "type": "array" },
    "missing_evidence": { "type": "array", "items": { "type": "string" } },
    "conflict_summary": { "type": "array" },
    "recommended_next_action": { "type": "string" },
    "questions_for_emperor": { "type": "array", "items": { "type": "string" } },
    "source_label": { "enum": ["LIVE", "LIVE_SWARM", "MIXED", "FALLBACK", "DEMO"] }
  }
}
