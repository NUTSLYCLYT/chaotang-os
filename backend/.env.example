# chaotang-os backend example environment variables.
# Copy this file to backend/.env for local development.
# Never commit real secrets or a real .env file (see repo root .gitignore).

# Reference values for the host/port used to run the API locally, e.g.
#   uvicorn app.main:app --host 127.0.0.1 --port 8000
# NOTE: these two variables are not yet read by any code or by the documented
# Run command in backend/AGENTS.md (uvicorn's --host/--port are passed as
# literal flags, not sourced from the environment). They are kept here as
# copy-paste reference values for local development; wiring them into the
# run command is out of scope for this module.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# DeepSeek API key used by the DeepSeek-backed LangGraph graph factory
# (app.langgraph_runtime.build_deepseek_graph) to construct the production
# openai.OpenAI client pointed at DeepSeek's OpenAI-compatible endpoint. Get
# a real value from https://platform.deepseek.com. Never commit a real
# value here; for local development, copy this file to backend/.env and set
# the real key there (backend/.env is gitignored).
DEEPSEEK_API_KEY=
