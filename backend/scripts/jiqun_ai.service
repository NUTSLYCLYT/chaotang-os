[Unit]
Description=Jiqun (Fengqun) Multi-Agent Swarm Web UI
Documentation=https://github.com/your-org/jiqun_ai
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ── 按实际部署机器调整 User；运行器固定使用项目 .venv ──
User=ubuntu
WorkingDirectory=/home/ubuntu/Projects/chaotang-os/backend

# 密钥与运行配置从 .env 注入（含 DEEPSEEK_API_KEY / MINIMAX_API_KEY / FENGQUN_*）。
# .env 已 gitignore，权限建议 600。
EnvironmentFile=/home/ubuntu/Projects/chaotang-os/backend/.env
Environment=FENGQUN_SCHEMA_MODE=strict

# ── 代理绕过：systemd 环境默认不继承 shell 代理；显式声明确保
#    api.deepseek.com 走直连（本机代理到不了 DeepSeek，会 000）。
#    MiniMax(api.minimaxi.com) 若改走代理，再按需调整。──
Environment=NO_PROXY=localhost,127.0.0.1,api.deepseek.com
Environment=no_proxy=localhost,127.0.0.1,api.deepseek.com
Environment=PYTHONUNBUFFERED=1

# FastAPI(ASGI) 必须用 UvicornWorker —— bind / worker-class / workers 全部
# 取自 gunicorn.conf.py（bind=127.0.0.1:8081, UvicornWorker），勿用 gthread。
ExecStart=/usr/bin/env FENGQUN_SCHEMA_MODE=strict /home/ubuntu/Projects/chaotang-os/backend/.venv/bin/python -m gunicorn -c gunicorn.conf.py web.main:app

Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

# 日志由 journald 接管
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jiqun_ai

# 资源限制（防止 chromadb / litellm 内存暴涨）
LimitNOFILE=65536
MemoryMax=4G

[Install]
WantedBy=multi-user.target
